{
  "name": "moha-motion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hand-gesture soundboard, sampler, looper and performance recorder that runs in the browser.",
  "scripts": {
    "vendor": "node scripts/vendor-mediapipe.mjs",
    "predev": "node scripts/vendor-mediapipe.mjs",
    "dev": "vite",
    "dev:phone": "node scripts/vendor-mediapipe.mjs && vite --host --mode phone",
    "prebuild": "node scripts/vendor-mediapipe.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
}
